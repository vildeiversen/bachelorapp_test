<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <!-- HVA: Legger til nødvendige tillatelser for pålitelig bakgrunnssporing. -->
    <!-- HVORFOR: Moderne Android-versjoner krever disse eksplisitte tillatelsene -->
    <!-- for å kjøre en tjeneste som viser varslinger (POST_NOTIFICATIONS) og -->
    <!-- sporer lokasjon i bakgrunnen (FOREGROUND_SERVICE_LOCATION). Uten disse -->
    <!-- krasjer appen umiddelbart på nyere telefoner. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BachelorAppH2025">

        <!-- Legg inn din Google Maps API-nøkkel her -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyCxRAmrrnCPvrfsjNbqAt1uCMH6dkdewS4" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BachelorAppH2025">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HVA: Registrerer den nye TrackingService. -->
        <!-- HVORFOR: Uten denne registreringen vet ikke Android-systemet at servicen -->
        <!-- eksisterer, og appen vil krasje når man prøver å starte den. -->
        <service
            android:name=".location.TrackingService"
            android:foregroundServiceType="location" />

    </application>

</manifest>

